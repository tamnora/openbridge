# Plantilla de credenciales de deploy del hub PHP. Copiala a `.deploy.env`
# (gitignored) y completa los valores. Tambien se pueden pasar por entorno.
DEPLOY_PROTOCOL=ftps
DEPLOY_HOST=ftp.example.com
DEPLOY_PORT=21
DEPLOY_USER=usuario@example.com
DEPLOY_PASS=cambiar
DEPLOY_REMOTE=/
DEPLOY_LOCAL=php/dist
# 1 = no validar el certificado TLS; 0 = exigir hostname valido.
DEPLOY_INSECURE=1
